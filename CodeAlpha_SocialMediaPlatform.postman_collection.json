{
  "info": {
    "name": "CodeAlpha_SocialMediaPlatform",
    "description": "Full Stack Internship Task 2 - Social Media Platform API.\n\nSETUP:\n1. Start server: npm run dev\n2. Run '01 - Auth > Register User 1' — the token is saved automatically\n3. Run requests top to bottom\n\nVariables (token, postId, userId, commentId) are captured automatically by test scripts, so you rarely need to paste IDs by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "token2",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "username",
      "value": "ali_khan",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Confirms the server is running. No auth needed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register User 1 (Ali)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  pm.collectionVariables.set('userId', res.user._id);",
                  "  pm.collectionVariables.set('username', res.user.username);",
                  "  console.log('Token saved for user 1');",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ali Khan\",\n  \"username\": \"ali_khan\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates the main test account. Token is saved to {{token}} automatically."
          },
          "response": []
        },
        {
          "name": "Register User 2 (Sara)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token2', res.token);",
                  "  pm.collectionVariables.set('userId2', res.user._id);",
                  "  console.log('Token saved for user 2');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sara Ahmed\",\n  \"username\": \"sara_ahmed\",\n  \"email\": \"sara@example.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Second account, needed to demo the follow system and feed."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  pm.collectionVariables.set('userId', res.user._id);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Switch active account by changing the email here."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Verifies the token works. Used by the frontend to restore a session on page reload."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Users & Profile",
      "item": [
        {
          "name": "Get Profile by Username",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{username}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{username}}"
              ]
            },
            "description": "Public profile + that user's posts. Uses USERNAME, not ID."
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ali Khan\",\n  \"bio\": \"Full Stack Developer | CodeAlpha Intern\",\n  \"avatar\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "profile"
              ]
            },
            "description": "Edits the logged-in user only. All three fields are optional."
          },
          "response": []
        },
        {
          "name": "Search Users",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?q=a",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "a"
                }
              ]
            },
            "description": "Case-insensitive match on username or full name."
          },
          "response": []
        },
        {
          "name": "Who To Follow (Suggestions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/suggestions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "suggestions"
              ]
            },
            "description": "Users you don't already follow, excluding yourself."
          },
          "response": []
        },
        {
          "name": "Followers List",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Everyone following this user.",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{username}}/followers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{username}}",
                "followers"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Following List",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Everyone this user follows.",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{username}}/following",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{username}}",
                "following"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Follow System",
      "item": [
        {
          "name": "Follow / Unfollow User (toggle)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId2}}/follow",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId2}}",
                "follow"
              ]
            },
            "description": "Toggle follow. Returns BOTH followersCount (the target's) and myFollowingCount (yours) so the UI can update the correct number."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.post && res.post._id) {",
                  "  pm.collectionVariables.set('postId', res.post._id);",
                  "  console.log('postId saved: ' + res.post._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"My first post on the CodeAlpha social app!\",\n  \"image\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            },
            "description": "Post ID is saved to {{postId}} automatically for the like and comment requests."
          },
          "response": []
        },
        {
          "name": "Explore (people you DON’T follow)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/explore?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "explore"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Discovery feed. When authenticated it excludes yourself and everyone you already follow, so it never duplicates the Home feed."
          },
          "response": []
        },
        {
          "name": "My Feed (Followed Users)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "feed"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Posts from people you follow plus your own. Empty until you follow someone."
          },
          "response": []
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "Owner only — returns 403 for someone else's post. Deletes that post's comments too."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Likes",
      "item": [
        {
          "name": "Like / Unlike Post (toggle)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/like",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}",
                "like"
              ]
            },
            "description": "No body needed. First send returns isLiked true, second returns false."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Comments",
      "item": [
        {
          "name": "Add Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.comment && res.comment._id) {",
                  "  pm.collectionVariables.set('commentId', res.comment._id);",
                  "  console.log('commentId saved: ' + res.comment._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Nice post!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}",
                "comments"
              ]
            },
            "description": "Also increments commentCount on the post."
          },
          "response": []
        },
        {
          "name": "Get Comments",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}",
                "comments"
              ]
            },
            "description": "Oldest first, with author details populated."
          },
          "response": []
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "comments",
                "{{commentId}}"
              ]
            },
            "description": "Owner only. Decrements the post's commentCount."
          },
          "response": []
        }
      ]
    },
    {
      "name": "07 - Uploads",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [],
            "description": "multipart/form-data with a field named \"image\". Goes to Cloudinary if the keys are set in .env, otherwise saved to /uploads. Max 5 MB, JPG/PNG/WEBP/GIF only.",
            "url": {
              "raw": "{{baseUrl}}/api/upload?type=post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "post",
                  "description": "post or avatar"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Pick an image file"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}