{
  "name": "codealpha-social-media-platform",
  "version": "2.0.0",
  "description": "Echo - a mini social media platform. React + Redux Toolkit frontend, Express + MongoDB backend. CodeAlpha Full Stack Internship Task 2.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm --prefix client run dev",
    "client:install": "npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix client install"
  },
  "keywords": ["social-media", "express", "mongodb", "react", "redux", "codealpha"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
